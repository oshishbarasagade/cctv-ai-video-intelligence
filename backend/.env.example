# Copy to .env. ALL OPTIONAL — Subli 2.0 runs fully offline without any of it.

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth (offline token signing secret) ---
AUTH_SECRET=change-me-in-production

# --- CV pipeline ---
MAX_UPLOAD_MB=500
MAX_FRAMES=300
FORCE_FALLBACK=0
CAPTION_MODEL=Salesforce/blip-image-captioning-base

# --- Real services (leave blank for offline mode) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLAUDE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
